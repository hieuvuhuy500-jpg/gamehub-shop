<%- include("partials/header", { title: "Trang cá nhân & Tài khoản" }) %>
<main class="wrap page">
  <div class="page-title">
    <span class="eyebrow">TÀI KHOẢN CỦA BẠN</span>
    <h1>Trang cá nhân</h1>
    <p>Quản lý ảnh đại diện, số dư ví, thông tin tài khoản game đã mua và lịch sử giao dịch.</p>
  </div>

  <section class="panel" style="margin-bottom:24px;">
    <h2>Thông tin cá nhân</h2>
    <div style="display:flex;gap:24px;flex-wrap:wrap;align-items:flex-start;">
      <div style="text-align:center;min-width:140px;">
        <% const avatarInitial = (user && user.name ? user.name.trim()[0] : "U").toUpperCase(); %>
        <div id="avatar-box" style="width:110px;height:110px;border-radius:50%;overflow:hidden;margin:0 auto 10px;border:3px solid #ef4444;background:#1f2937;color:#fff;display:flex;align-items:center;justify-content:center;font-size:40px;font-weight:700;">
          <% if (user && user.avatar) { %>
            <img id="avatar-preview" src="<%= user.avatar %>" alt="Ảnh đại diện" style="width:100%;height:100%;object-fit:cover;">
          <% } else { %>
            <span id="avatar-fallback"><%= avatarInitial %></span>
            <img id="avatar-preview" src="" alt="Ảnh đại diện" style="display:none;width:100%;height:100%;object-fit:cover;">
          <% } %>
        </div>
        <div style="font-weight:700;"><%= user.name %></div>
        <small style="opacity:0.75;"><%= user.email %></small>
        <div style="margin-top:8px;font-weight:700;color:#16a34a;">
          Số dư: <%= money(user.balance) %>
        </div>
        <div style="margin-top:10px;">
          <a href="/nap-tien" class="btn" style="display:inline-block;padding:6px 14px;text-decoration:none;">+ Nạp tiền</a>
        </div>
      </div>

      <form id="profile-form" method="POST" action="/tai-khoan/ho-so" style="flex:1;min-width:260px;display:grid;gap:12px;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="avatarData" id="avatar-data-input" value="">

        <label style="display:grid;gap:6px;">
          <span>Tên hiển thị</span>
          <input type="text" name="name" value="<%= user.name %>" required minlength="2" maxlength="60" style="padding:8px 10px;">
        </label>

        <label style="display:grid;gap:6px;">
          <span>Chọn ảnh cá nhân từ máy / điện thoại (PNG, JPG, WEBP)</span>
          <input type="file" id="avatar-file-input" accept="image/png,image/jpeg,image/webp" style="padding:6px 0;">
          <small style="opacity:0.75;">Ảnh sẽ được tự động nén gọn để tải nhanh và lưu bền vững.</small>
        </label>

        <label style="display:grid;gap:6px;">
          <span>Hoặc dán link ảnh HTTPS (tùy chọn)</span>
          <input type="url" name="avatarUrl" placeholder="https://..." maxlength="500" style="padding:8px 10px;">
        </label>

        <% if (user && user.avatar) { %>
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
            <input type="checkbox" name="removeAvatar" value="1">
            <span>Xóa ảnh cá nhân hiện tại</span>
          </label>
        <% } %>

        <div>
          <button type="submit" class="btn" style="padding:8px 18px;cursor:pointer;">Lưu thay đổi</button>
        </div>
      </form>
    </div>
  </section>

  <section class="panel" style="margin-bottom:24px;">
    <h2>Tài khoản đã mua &amp; Lịch sử mua hàng (<%= orders.length %>)</h2>
    <% if (!orders || orders.length === 0) { %>
      <p class="empty">Bạn chưa mua tài khoản nào. <a href="/">Xem cửa hàng ngay</a>.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Mã đơn</th>
              <th>Sản phẩm</th>
              <th>Thông tin tài khoản đã mua</th>
              <th>Giá mua</th>
              <th>Thời gian</th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach((o, idx) => {
              const deliveryText = typeof o.delivery === "string"
                ? o.delivery
                : (o.delivery && o.delivery.username !== undefined)
                  ? `${o.delivery.username}${o.delivery.password ? " | " + o.delivery.password : ""}`
                  : JSON.stringify(o.delivery || "");
            %>
              <tr>
                <td>#<%= o.id %></td>
                <td><strong><%= o.productName %></strong></td>
                <td>
                  <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                    <code id="acc-<%= idx %>" style="padding:4px 8px;border-radius:4px;background:rgba(148,163,184,0.18);font-weight:600;word-break:break-all;"><%= deliveryText %></code>
                    <button type="button" onclick="copyAcc('acc-<%= idx %>', this)" style="padding:4px 8px;cursor:pointer;border-radius:4px;border:1px solid #9ca3af;background:transparent;">Sao chép</button>
                  </div>
                </td>
                <td><%= money(o.price) %></td>
                <td><%= new Date(o.createdAt).toLocaleString("vi-VN") %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <section class="panel">
    <h2>Lịch sử nạp tiền (<%= topups.length %>)</h2>
    <% if (!topups || topups.length === 0) { %>
      <p class="empty">Chưa có giao dịch nạp tiền nào.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Mã giao dịch</th>
              <th>Số tiền</th>
              <th>Phương thức</th>
              <th>Trạng thái</th>
              <th>Thời gian</th>
            </tr>
          </thead>
          <tbody>
            <% topups.forEach(t => { %>
              <tr>
                <td><code><%= t.bankReference || t.id %></code></td>
                <td><strong><%= money(t.amount) %></strong></td>
                <td><%= t.method %></td>
                <td>
                  <%= t.status === "paid" ? "Thành công" : t.status === "pending" ? "Đang chờ xác nhận" : t.status === "adjusted" ? "Đã điều chỉnh" : "Đã hủy" %>
                </td>
                <td><%= new Date(t.createdAt).toLocaleString("vi-VN") %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>
</main>

<script>
  function copyAcc(id, btn) {
    const el = document.getElementById(id);
    if (!el) return;
    navigator.clipboard.writeText(el.textContent.trim()).then(() => {
      const old = btn.textContent;
      btn.textContent = "Đã chép";
      setTimeout(() => { btn.textContent = old; }, 1500);
    });
  }

  const fileInput = document.getElementById("avatar-file-input");
  const dataInput = document.getElementById("avatar-data-input");
  const previewImg = document.getElementById("avatar-preview");
  const fallbackEl = document.getElementById("avatar-fallback");

  if (fileInput) {
    fileInput.addEventListener("change", function () {
      const file = this.files && this.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function (ev) {
        const img = new Image();
        img.onload = function () {
          const size = 200;
          const canvas = document.createElement("canvas");
          canvas.width = size;
          canvas.height = size;
          const ctx = canvas.getContext("2d");
          const minSide = Math.min(img.width, img.height);
          const sx = (img.width - minSide) / 2;
          const sy = (img.height - minSide) / 2;
          ctx.drawImage(img, sx, sy, minSide, minSide, 0, 0, size, size);
          const compressed = canvas.toDataURL("image/jpeg", 0.78);
          dataInput.value = compressed;
          previewImg.src = compressed;
          previewImg.style.display = "block";
          if (fallbackEl) fallbackEl.style.display = "none";
        };
        img.src = ev.target.result;
      };
      reader.readAsDataURL(file);
    });
  }
</script>
<%- include("partials/footer") %>