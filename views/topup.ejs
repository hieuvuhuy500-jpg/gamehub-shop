<%- include("partials/header",{title:"Nạp tiền vào ví"}) %>
<main class="wrap page narrow">
  <div class="page-title">
    <span class="eyebrow red">GTN WALLET</span>
    <h1>Nạp tiền vào ví</h1>
    <p>Số dư hiện tại: <b><%= money(user.balance) %></b></p>
  </div>

  <section class="panel topup-alternatives" aria-labelledby="topup-alternatives-title">
    <h2 id="topup-alternatives-title">Phương thức nạp khác</h2>
    <div class="topup-method-grid">
      <article class="topup-method">
        <div class="topup-method-heading">
          <strong>Chuyển khoản ngân hàng</strong>
          <span class="topup-method-status"><%= bankReady?"Đã cấu hình":"Chờ cấu hình" %></span>
        </div>
        <% if(bankReady){ %>
          <p>Chuyển khoản bằng mã nội dung riêng. Ví chỉ được cộng sau khi SePay xác minh đúng số tiền và giao dịch hoặc được quản trị viên xác nhận.</p>
          <form method="post" action="/nap-tien/chuyen-khoan">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label for="bank-topup-amount">Số tiền (VNĐ)
              <input id="bank-topup-amount" type="number" name="amount" min="10000" max="50000000" step="1000" required placeholder="Ví dụ: 100000">
            </label>
            <button class="btn btn-red full" type="submit">Tạo lệnh chuyển khoản</button>
          </form>
        <% }else{ %>
          <p>Cần tài khoản nhận tiền, khóa webhook SePay và domain HTTPS công khai. Ví chỉ được cộng sau khi giao dịch được xác minh.</p>
        <% } %>
      </article>
    </div>
  </section>
</main>
<%- include("partials/footer") %>