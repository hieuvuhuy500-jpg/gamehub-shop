<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title!=="undefined"?title+" | GTN GAMING SHOP":"GTN GAMING SHOP" %></title>
  <script>
    try {
      if (localStorage.getItem("gamehub-theme") === "dark") {
        document.documentElement.dataset.theme = "dark";
      }
    } catch (error) {
      console.warn("Không thể đọc tùy chọn giao diện đã lưu.", error);
    }
  </script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<header class="top">
  <div class="wrap nav">
    <a class="brand" href="/" aria-label="GTN Gaming Shop - Trang chủ">
      <span class="brand-copy"><strong>GTN</strong><small>GAMING SHOP</small></span>
    </a>
    <% if(!user||user.role!=="admin"){ %>
    <div class="nav-quick-actions">
      <button class="btn btn-outline theme-toggle" id="theme-toggle" type="button" aria-label="Chuyển sang giao diện tối" aria-pressed="false" title="Chuyển sang giao diện tối">
        <span class="theme-icon" aria-hidden="true">🌙</span>
        <span class="theme-label">Tối</span>
      </button>
      <% if(!user){ %>
        <a href="/dang-nhap">Đăng nhập</a>
        <a class="btn btn-red" href="/dang-ky">Đăng ký</a>
      <% } %>
    </div>
    <% } %>
    <details class="nav-menu">
      <summary class="nav-menu-toggle" aria-label="Mở hoặc đóng danh mục tác vụ">
        <span class="nav-menu-icon" aria-hidden="true"><i></i><i></i><i></i></span>
      </summary>
      <div class="nav-menu-content">
        <nav>
          <% if(user&&user.role==="admin"){ %>
            <a href="/admin">Khu vực quản trị</a>
            <a href="/">Cửa hàng</a>
          <% }else{ %>
            <a href="/">Sản phẩm</a>
            <a href="/#game-categories">Danh mục game</a>
            <a href="/bang-xep-hang">Xếp hạng</a>
            <% if(!user){ %><a href="/nap-tien">Nạp tiền</a><% } %>
          <% } %>
        </nav>
        <% if(user&&user.role==="admin"){ %>
        <div class="nav-right">
          <button class="btn btn-outline theme-toggle" id="theme-toggle" type="button" aria-label="Chuyển sang giao diện tối" aria-pressed="false" title="Chuyển sang giao diện tối">
            <span class="theme-icon" aria-hidden="true">🌙</span>
            <span class="theme-label">Tối</span>
          </button>
          <a class="nav-user" href="/admin">Admin: <%= user.name %></a>
          <a class="btn btn-dark" href="/">Cửa hàng</a>
          <form action="/dang-xuat" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline" type="submit">Đăng xuất</button></form>
        </div>
        <% }else if(user){ %>
        <div class="nav-right">
          <a class="btn btn-red" href="/nap-tien">Nạp tiền</a>
          <a class="nav-user" href="/tai-khoan" style="display:inline-flex;align-items:center;gap:8px;">
            <% const navInitial = (user.name ? user.name.trim()[0] : "U").toUpperCase(); %>
            <% if (user.avatar) { %>
              <img src="<%= user.avatar %>" alt="<%= user.name %>" style="width:28px;height:28px;border-radius:50%;object-fit:cover;border:2px solid #ef4444;flex-shrink:0;">
            <% } else { %>
              <span style="width:28px;height:28px;border-radius:50%;background:#ef4444;color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;flex-shrink:0;"><%= navInitial %></span>
            <% } %>
            <span><%= user.name %></span>
          </a>
          <form action="/dang-xuat" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline" type="submit">Thoát</button></form>
        </div>
        <% } %>
      </div>
    </details>
  </div>
</header>
<% if(notice){ %><div class="notice wrap"><%= notice %></div><% } %>