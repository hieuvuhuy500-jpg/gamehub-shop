<%- include("partials/header",{title:"Quản trị"}) %>
<main class="wrap page">
  <div class="page-title">
    <span class="eyebrow red">CONTROL CENTER</span>
    <h1>Quản trị hệ thống</h1>
    <p>Quản lý danh mục, kho tài khoản, đơn hàng và giao dịch nạp tiền.</p>
  </div>

  <div class="stats admin-stats">
    <div class="stat"><small>Mặt hàng</small><strong><%= stats.products %></strong></div>
    <div class="stat"><small>Tài khoản còn kho</small><strong><%= stats.inventory %></strong></div>
    <div class="stat"><small>Thành viên</small><strong><%= stats.users %></strong></div>
    <div class="stat"><small>Đơn hàng</small><strong><%= stats.orders %></strong></div>
    <div class="stat"><small>Doanh thu</small><strong><%= money(stats.revenue) %></strong></div>
  </div>

  <section class="panel" id="admin-chat-box">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:12px;">
      <h2 style="margin:0;">Tin nhắn người mua</h2>
      <span class="pill green">Trực tiếp</span>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;">
      <div id="admin-customer-list" style="display:flex;flex-direction:column;gap:8px;max-height:320px;overflow-y:auto;"></div>
      <div style="display:flex;flex-direction:column;gap:10px;">
        <div id="admin-chat-thread" style="display:flex;flex-direction:column;gap:8px;min-height:220px;max-height:280px;overflow-y:auto;padding:12px;border:1px solid var(--line);border-radius:10px;background:var(--bg);"></div>
        <form id="admin-chat-form" style="display:flex;gap:8px;">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input id="admin-chat-input" type="text" maxlength="1000" required placeholder="Chọn người mua và nhập tin nhắn trả lời...">
          <button class="btn btn-red" type="submit">Trả lời</button>
        </form>
      </div>
    </div>
  </section>

  <section class="panel" style="border:2px solid #f59e0b;">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;margin-bottom:12px;">
      <h2 style="margin:0;">Yêu cầu nạp tiền chờ xác nhận (<%= stats.pendingTopupsCount || 0 %>)</h2>
      <strong>Tổng cần xác nhận: <%= money(stats.pendingTopupsAmount || 0) %></strong>
    </div>

    <% if (!pendingTopups || pendingTopups.length === 0) { %>
      <p class="empty">Hiện không có yêu cầu nạp tiền nào đang chờ xác nhận.</p>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Khách hàng</th>
              <th>Nội dung CK</th>
              <th>Số tiền cần cộng</th>
              <th>Ví hiện tại</th>
              <th>Thời gian</th>
              <th>Xác nhận</th>
            </tr>
          </thead>
          <tbody>
            <% pendingTopups.forEach(t => { %>
              <tr>
                <td><strong><%= t.userName %></strong><br><small><%= t.userEmail %></small></td>
                <td><code><%= t.bankReference || t.id %></code><br><small><%= t.method %></small></td>
                <td style="font-weight:700;color:#dc2626;">+<%= money(t.amount) %></td>
                <td><%= money(t.userBalance) %></td>
                <td><%= new Date(t.createdAt).toLocaleString("vi-VN") %></td>
                <td style="white-space:nowrap;">
                  <form method="POST" action="/admin/nap-tien/<%= t.id %>/duyet" onsubmit="return confirm('Xác nhận đã nhận <%= money(t.amount) %> và cộng vào ví <%= t.userEmail %>?');" style="display:inline-block;margin-right:6px;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" style="padding:6px 12px;background:#16a34a;color:#fff;border:none;border-radius:6px;cursor:pointer;">Xác nhận &amp; Cộng ví</button>
                  </form>
                  <form method="POST" action="/admin/nap-tien/<%= t.id %>/tu-choi" onsubmit="return confirm('Từ chối yêu cầu nạp này?');" style="display:inline-block;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" style="padding:6px 10px;background:#ef4444;color:#fff;border:none;border-radius:6px;cursor:pointer;">Từ chối</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <section class="panel">
    <h2>Danh mục và tồn kho</h2>
    <p class="admin-help">Tồn kho được tính từ số tài khoản đã nhập mã hóa. Danh mục game vẫn được giữ lại sau khi xóa sản phẩm để bạn có thể thêm hàng sau.</p>
    <% if(categories.length){ %>
      <div class="admin-category-list">
        <a class="<%= !selectedGame?'active':'' %>" href="/admin"><strong>Tất cả game</strong><span><%= stats.products %> sản phẩm · <%= stats.inventory %> tài khoản</span></a>
        <% categories.forEach(category=>{ %>
          <a class="<%= selectedGame===category.name?'active':'' %>" href="<%= category.href %>"><strong><%= category.label %></strong><span><%= category.stock %> tài khoản</span></a>
        <% }) %>
      </div>
    <% }else{ %><p class="empty">Chưa có danh mục có hàng.</p><% } %>
  </section>

  <section class="panel">
    <h2>Thêm sản phẩm</h2>
    <p class="admin-help">Nhập mỗi tài khoản theo dòng <code>tên đăng nhập|mật khẩu</code>. Nếu cùng tên sản phẩm và danh mục đã có, tài khoản mới sẽ được cộng vào kho hiện tại; kho và thông tin cũ được giữ nguyên. Sản phẩm khác tên sẽ được tạo riêng. Dữ liệu được mã hóa trước khi lưu và chỉ giao cho khách sau khi mua.</p>
    <form class="admin-form" method="post" action="/admin/san-pham">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Danh mục / game<input name="game" value="<%= selectedGame %>" list="product-categories" required maxlength="60" placeholder="Free Fire"></label>
      <datalist id="product-categories">
        <% categories.forEach(category=>{ %><option value="<%= category.name %>"></option><% }) %>
      </datalist>
      <label>Tên sản phẩm<input name="name" required maxlength="120"></label>
      <label>Giá (VNĐ)<input name="price" type="number" min="1000" max="50000000" required></label>
      <label class="wide admin-image-field">Link ảnh
        <input name="image" maxlength="500" placeholder="Dán link ảnh công khai" data-image-preview-input>
        <small class="admin-image-help">Ảnh cần mở trực tiếp được và cho phép nhúng; link trang chia sẻ hoặc trang web thường không dùng làm link ảnh được.</small>
        <span class="admin-image-status" data-image-preview-status aria-live="polite">Dán link để xem trước ảnh.</span>
        <img class="admin-image-preview" src="/images/gamehub-placeholder.svg" alt="Xem trước ảnh sản phẩm" data-image-preview hidden>
      </label>
      <label class="wide">Mô tả<input name="description" maxlength="1000"></label>
      <label class="wide">Tên đăng nhập và mật khẩu tài khoản (mỗi dòng: tài khoản|mật khẩu)<textarea name="accounts" rows="5" maxlength="80000" placeholder="email@example.com|mat-khau"></textarea></label>
      <button class="btn btn-red" type="submit">Thêm sản phẩm / cộng kho</button>
    </form>
  </section>

  <section class="panel">
    <h2>Quản lý sản phẩm<% if(selectedGame){ %> · <%= selectedGame %><% } %></h2>
    <p class="admin-help"><%= selectedGame?`Đang hiển thị sản phẩm thuộc danh mục ${selectedGame}.`:"Chọn một game ở trên để lọc sản phẩm cần quản lý." %></p>
    <div class="table-wrap">
      <table class="admin-products-table">
        <thead><tr><th>Mã</th><th>Thông tin sản phẩm</th><th>Thao tác</th></tr></thead>
        <tbody>
          <% products.forEach(p=>{ %>
            <tr>
              <td>#<%= p.id %></td>
              <td>
                <form class="admin-product-form" method="post" action="/admin/san-pham/<%= p.id %>/cap-nhat">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <label>Danh mục<input name="game" value="<%= p.game %>" list="product-categories" required maxlength="60"></label>
                  <label>Tên sản phẩm<input name="name" value="<%= p.name %>" required maxlength="120"></label>
                  <label>Giá<input name="price" type="number" min="1000" max="50000000" value="<%= p.price %>" required></label>
                  <label class="wide admin-image-field">Link ảnh
                    <input name="image" value="<%= p.image %>" maxlength="500" data-image-preview-input>
                    <small class="admin-image-help">Ảnh cần mở trực tiếp được và cho phép nhúng; link trang chia sẻ hoặc trang web thường không dùng làm link ảnh được.</small>
                    <span class="admin-image-status" data-image-preview-status aria-live="polite">Dán link để xem trước ảnh.</span>
                    <img class="admin-image-preview" src="/images/gamehub-placeholder.svg" alt="Xem trước ảnh sản phẩm" data-image-preview hidden>
                  </label>
                  <label class="wide">Mô tả<input name="description" value="<%= p.description %>" maxlength="1000"></label>
                  <label class="wide">Thêm tài khoản/mật khẩu vào kho (mỗi dòng: tài khoản|mật khẩu)<textarea name="accounts" rows="3" maxlength="80000" placeholder="email@example.com|mat-khau"></textarea></label>
                  <button class="btn btn-small btn-red" type="submit">Lưu / thêm kho</button>
                </form>
                <small class="admin-status">Còn <%= p.stock %> tài khoản</small>
              </td>
              <td>
                <form method="post" action="/admin/san-pham/<%= p.id %>/xoa" onsubmit="return confirm('Xóa sản phẩm này?')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-small btn-outline" type="submit">Xóa</button>
                </form>
              </td>
            </tr>
          <% }) %>
          <% if(!products.length){ %><tr><td colspan="3" class="empty">Chưa có sản phẩm. Hãy thêm hàng hóa thật trước khi mở bán.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="panel">
    <h2>Giao dịch nạp tiền</h2>
    <p class="admin-help">Số dư chỉ được cộng sau khi VNPay IPN hoặc SePay webhook xác thực giao dịch, số tiền khớp và mã giao dịch chưa xử lý. Không xác nhận giao dịch thủ công.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Mã giao dịch</th><th>Thành viên</th><th>Số tiền</th><th>Phương thức</th><th>Ngân hàng</th><th>Trạng thái</th><th>Thời gian</th></tr></thead>
        <tbody>
          <% topups.forEach(t=>{ const u=users.find(x=>x.id===t.userId); %>
            <tr>
              <td><%= t.transactionNo||t.id %></td><td><%= u?u.email:"Không rõ" %></td><td><%= money(t.amount) %></td>
              <td><%= t.method %></td>
              <td><%= t.bankCode||"—" %></td>
              <td><%= t.status==="paid"?"Đã thanh toán":t.status==="pending"?"Đang chờ":t.status==="failed"?"Thất bại":t.status %></td>
              <td><%= new Date(t.paidAt||t.createdAt).toLocaleString("vi-VN") %></td>
            </tr>
          <% }) %>
          <% if(!topups.length){ %><tr><td colspan="7" class="empty">Chưa có giao dịch nạp.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="panel">
    <h2>Đơn hàng</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Mã</th><th>Sản phẩm</th><th>Giá</th><th>Trạng thái</th><th>Ngày</th></tr></thead>
        <tbody>
          <% orders.forEach(o=>{ %><tr><td>#<%= o.id %></td><td><%= o.productName %></td><td><%= money(o.price) %></td><td><%= o.status %></td><td><%= new Date(o.createdAt).toLocaleDateString("vi-VN") %></td></tr><% }) %>
          <% if(!orders.length){ %><tr><td colspan="5" class="empty">Chưa có đơn hàng.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="panel">
    <h2>Thành viên</h2>
    <p class="admin-help">Admin chỉ thấy tên, email và số dư của khách hàng. Mật khẩu được băm một chiều và không được gửi tới trang quản trị. Xóa tài khoản sẽ chặn thành viên đăng nhập; lịch sử đơn hàng và giao dịch nạp tiền vẫn được lưu.</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Tên</th><th>Email</th><th>Số dư</th><th>Thao tác</th></tr></thead>
        <tbody>
          <% users.filter(u=>u.role!=="admin").forEach(u=>{ %>
            <tr>
              <td><%= u.name %></td><td><%= u.email %></td><td><%= money(u.balance) %></td>
              <td>
                <form method="POST" action="/admin/thanh-vien/<%= u.id %>/so-du" style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin-bottom:6px;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <select name="action" style="padding:4px 6px;">
                    <option value="add">Cộng (+)</option>
                    <option value="subtract">Trừ (-)</option>
                  </select>
                  <input type="number" name="amount" min="1000" max="100000000" step="1000" placeholder="Số tiền (VNĐ)" required style="width:120px;padding:4px 6px;">
                  <input type="text" name="note" maxlength="200" placeholder="Ghi chú" style="width:130px;padding:4px 6px;">
                  <button type="submit" style="padding:4px 10px;cursor:pointer;">Cập nhật</button>
                </form>
              </td>
            </tr>
          <% }) %>
          <% if(!users.some(u=>u.role!=="admin")){ %><tr><td colspan="4" class="empty">Chưa có thành viên.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </section>
</main>

<script>
  (() => {
    const custEl = document.getElementById("admin-customer-list");
    const threadEl = document.getElementById("admin-chat-thread");
    const formEl = document.getElementById("admin-chat-form");
    const inputEl = document.getElementById("admin-chat-input");
    if (!custEl || !threadEl || !formEl || !inputEl) return;

    const csrfToken = formEl.querySelector('input[name="_csrf"]')?.value || "";
    const escapeHtml = s => String(s || "").replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
    let selectedUserId = null;

    const loadAdminChat = async (userId = selectedUserId) => {
      try {
        const url = userId ? `/api/chat?userId=${encodeURIComponent(userId)}` : "/api/chat";
        const res = await fetch(url);
        if (!res.ok) return;
        const data = await res.json();
        selectedUserId = data.activeUserId || null;

        const customers = data.customers || [];
        custEl.innerHTML = customers.length
          ? customers.map(c => `
              <button type="button" data-uid="${c.id}" class="btn btn-outline" style="justify-content:flex-start;flex-direction:column;align-items:flex-start;border-radius:10px;padding:10px;${String(c.id) === String(selectedUserId) ? "border-color:var(--red);" : ""}">
                <strong>${escapeHtml(c.name)}</strong>
                <span style="font-size:11px;opacity:.75;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;">${escapeHtml(c.lastMessage || c.email)}</span>
              </button>
            `).join("")
          : '<p class="empty">Chưa có người mua nào.</p>';

        custEl.querySelectorAll("[data-uid]").forEach(btn => {
          btn.addEventListener("click", () => {
            selectedUserId = Number(btn.getAttribute("data-uid"));
            loadAdminChat(selectedUserId);
          });
        });

        const msgs = data.messages || [];
        threadEl.innerHTML = msgs.length
          ? msgs.map(m => {
              const isAdmin = m.senderRole === "admin";
              const timeStr = new Date(m.createdAt).toLocaleTimeString("vi-VN", { hour: "2-digit", minute: "2-digit" });
              return `
                <div style="align-self:${isAdmin ? "flex-end" : "flex-start"};max-width:82%;padding:9px 12px;border-radius:12px;background:${isAdmin ? "var(--red)" : "#171923"};color:#fff;">
                  <div style="font-size:10px;opacity:.8;margin-bottom:3px;">${escapeHtml(m.senderName)} • ${timeStr}</div>
                  <div style="font-size:13px;white-space:pre-wrap;overflow-wrap:anywhere;">${escapeHtml(m.text)}</div>
                </div>
              `;
            }).join("")
          : '<p class="empty" style="margin:0;">Chưa có tin nhắn trong cuộc trò chuyện này.</p>';
        threadEl.scrollTop = threadEl.scrollHeight;
      } catch {}
    };

    formEl.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!selectedUserId) return;
      const text = inputEl.value.trim();
      if (!text) return;
      inputEl.value = "";
      const res = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ _csrf: csrfToken, userId: selectedUserId, text })
      });
      if (res.ok) await loadAdminChat(selectedUserId);
    });

    loadAdminChat();
    setInterval(() => loadAdminChat(selectedUserId), 4000);
  })();
</script>
<%- include("partials/footer") %>