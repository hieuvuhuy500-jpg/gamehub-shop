<%- include("partials/header",{title:mode==="login"?"Đăng nhập":"Đăng ký"}) %><main class="wrap auth-wrap"><section class="auth-card"><div class="auth-side"><span class="eyebrow">WELCOME TO GTN</span><h1>YOUR GAME.<br><em>YOUR WORLD.</em></h1><p>Không gian quản lý tài khoản game của bạn.</p></div><form class="auth-form" method="post" action="<%= mode==='login'?'/dang-nhap':'/dang-ky' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><span class="eyebrow red">GTN ACCOUNT</span><h2><%= mode==="login"?"Đăng nhập":"Tạo tài khoản" %></h2><% if(mode==="register"){ %><label>Họ và tên<input name="name" required placeholder="Nguyễn Văn A"></label><% } %><label>Email<input name="email" type="email" required placeholder="you@example.com"></label><label>Mật khẩu<input name="password" type="password" minlength="8" required placeholder="Tối thiểu 8 ký tự"></label><button class="btn btn-red full"><%= mode==="login"?"Đăng nhập":"Đăng ký ngay" %></button><p class="muted"><%= mode==="login"?"Chưa có tài khoản?":"Đã có tài khoản?" %> <a href="<%= mode==='login'?'/dang-ky':'/dang-nhap' %>"><%= mode==="login"?"Đăng ký":"Đăng nhập" %></a></p></form></section></main><%- include("partials/footer") %>